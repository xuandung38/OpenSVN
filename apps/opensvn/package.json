{
  "name": "opensvn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "gen:ipc": "cargo run --locked --manifest-path src-tauri/Cargo.toml --bin gen_ipc -- src/ipc/bindings.ts",
    "dev:mock": "vite --mode mock",
    "lint:safety": "node scripts/lint-safety.mjs",
    "perf:spike": "tauri dev --config perf-tauri.conf.json"
  },
  "dependencies": {
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-virtual": "3.14.15",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-opener": "2.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "27.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
