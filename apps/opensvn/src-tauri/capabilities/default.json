{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for the main window: core defaults and the app's own commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-repo-info",
    "allow-repo-list",
    "allow-repo-cat",
    "allow-repo-save",
    "allow-log-get",
    "allow-blame-get",
    "allow-lock",
    "allow-unlock",
    "allow-remote-edit",
    "allow-branches-list",
    "allow-layout-get",
    "allow-layout-set",
    "allow-layout-detect",
    "allow-copy-location",
    "allow-op-cancel",
    "allow-op-list",
    "allow-auth-respond",
    "allow-accounts-list",
    "allow-accounts-sign-out",
    "allow-settings-get",
    "allow-settings-set",
    "allow-reveal-in-os",
    "allow-open-external",
    "allow-diagnostics-export",
    "allow-wc-list",
    "allow-wc-add-existing",
    "allow-wc-remove",
    "allow-wc-rename",
    "allow-wc-open",
    "allow-wc-close",
    "allow-status-get",
    "allow-status-refresh",
    "allow-status-remote",
    "allow-diff-get",
    "allow-changelist-set",
    "allow-ignore-add",
    "allow-mark-move",
    "allow-checkout",
    "allow-update",
    "allow-switch",
    "allow-commit",
    "allow-revert",
    "allow-add-paths",
    "allow-delete-paths",
    "allow-move-path",
    "allow-cleanup",
    "allow-set-depth",
    "allow-upgrade-format",
    "allow-resolve",
    "allow-props-set"
  ]
}
