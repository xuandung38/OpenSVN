{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window only. core:event:allow-listen / allow-unlisten: the UI subscribes to op://, wc:// and auth:// events emitted by Rust. No emit (UI talks to Rust through commands), no window/webview/menu/path/resources/app permissions: nothing in the UI needs them yet; add per-feature when a screen requires one. App commands are allowed one by one; program-choose / program-clear only open a native file dialog or clear a value (the program to run is picked and confirmed natively, never passed by the UI). opener:allow-open-url, scoped to https:// URLs only, lets the UI open links (revision pages, docs) in the browser; open-path, reveal and every other scheme stay denied.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    "allow-repo-info",
    "allow-repo-list",
    "allow-repo-cat",
    "allow-repo-save",
    "allow-log-get",
    "allow-blame-get",
    "allow-lock",
    "allow-unlock",
    "allow-remote-edit",
    "allow-branches-list",
    "allow-layout-get",
    "allow-layout-set",
    "allow-layout-detect",
    "allow-copy-location",
    "allow-op-cancel",
    "allow-op-list",
    "allow-auth-respond",
    "allow-accounts-list",
    "allow-accounts-sign-out",
    "allow-settings-get",
    "allow-settings-set",
    "allow-program-choose",
    "allow-program-clear",
    "allow-path-pick",
    "allow-reveal-in-os",
    "allow-open-external",
    "allow-diagnostics-export",
    "allow-wc-list",
    "allow-wc-add-existing",
    "allow-wc-remove",
    "allow-wc-rename",
    "allow-wc-open",
    "allow-wc-close",
    "allow-wc-entries",
    "allow-wc-locate",
    "allow-recent-urls",
    "allow-checkout-root-grant",
    "allow-checkout-root-choose",
    "allow-status-get",
    "allow-status-refresh",
    "allow-status-remote",
    "allow-diff-get",
    "allow-diff-external",
    "allow-changelist-set",
    "allow-ignore-add",
    "allow-mark-move",
    "allow-checkout",
    "allow-update",
    "allow-switch",
    "allow-commit",
    "allow-revert",
    "allow-add-paths",
    "allow-delete-paths",
    "allow-move-path",
    "allow-cleanup",
    "allow-set-depth",
    "allow-upgrade-format",
    "allow-resolve",
    "allow-props-set"
  ]
}
